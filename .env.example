# ── MAX ───────────────────────────────────────────────────────────
# Токен бота с платформы MAX для партнёров. Единственная обязательная переменная.
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# Ник бота для кнопок мини-приложения. Если пусто, берётся из GET /me.
MAX_BOT_USERNAME=

# ── Веб и API ─────────────────────────────────────────────────────
API_PORT=3000
# Порт мини-приложения на хосте: http://localhost:8080
WEB_PORT=8080
# Секрет подписи сессий. Если пусто, выводится из токена бота.
SESSION_SECRET=
SESSION_TTL_HOURS=24
INIT_DATA_MAX_AGE_SEC=86400
# true — вход демо-пользователем в обычном браузере. Только для отладки!
ALLOW_DEV_AUTH=false

# ── База данных ───────────────────────────────────────────────────
POSTGRES_USER=firstcommit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=firstcommit
# Нужен только при запуске backend вне Docker, в контейнерах собирается автоматически.
DATABASE_URL=postgres://firstcommit:change_me@localhost:5432/firstcommit

# ── Данные и расписание ───────────────────────────────────────────
# live — реальные источники (при сбое берётся снимок), offline — только снимки.
DATA_MODE=live
PARSER_INTERVAL_MIN=360
NOTIFY_INTERVAL_MIN=30
TZ=Europe/Moscow
