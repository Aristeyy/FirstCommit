# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- MAX ---
# Токен чат-бота, выданный организаторами (платформа MAX для партнёров → Чат-боты → ⋮ → Настройки)
MAX_BOT_TOKEN=
# Базовый адрес Bot API (сверяйтесь с актуальной документацией dev.max.ru перед сдачей)
MAX_API_BASE=https://platform-api2.max.ru
# Публичный HTTPS-адрес мини-приложения (указывается в настройках бота)
MINIAPP_URL=https://example.com

# --- Backend ---
API_PORT=3000
NODE_ENV=production

# --- PostgreSQL ---
POSTGRES_USER=firstcommit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=firstcommit
DATABASE_URL=postgres://firstcommit:change_me@db:5432/firstcommit

# --- Парсеры ---
# Режим данных: live — реальные источники, seed — подготовленный тестовый набор
DATA_MODE=seed
# Расписание обновления (cron)
PARSER_CRON=0 */6 * * *
