# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env не коммитится (см. .gitignore).

# --- MAX ---
# Токен чат-бота (выдан организаторами; платформа MAX для партнёров → Чат-боты → ⋮ → Настройки)
MAX_BOT_TOKEN=
# Базовый адрес Bot API (актуальный по документации dev.max.ru)
MAX_API_BASE=https://platform-api2.max.ru
# Ник бота. Можно не указывать — бот получит его сам через GET /me
MAX_BOT_USERNAME=

# --- Мини-приложение и API ---
API_PORT=3000
# Порт, на котором web (Caddy) доступен на хосте: http://localhost:8080
WEB_PORT=8080
# Секрет подписи сессий мини-приложения (если пусто — выводится из токена бота)
SESSION_SECRET=
SESSION_TTL_HOURS=24
# Срок годности initData из MAX, секунд
INIT_DATA_MAX_AGE_SEC=86400
# true — разрешить вход демо-пользователем при открытии в обычном браузере (только для отладки!)
ALLOW_DEV_AUTH=false

# --- PostgreSQL (DATABASE_URL для контейнеров собирается в compose.yaml) ---
POSTGRES_USER=firstcommit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=firstcommit
# Только для запуска backend вне Docker (npm run dev:*)
DATABASE_URL=postgres://firstcommit:change_me@localhost:5432/firstcommit

# --- Сбор данных и уведомления ---
# live — реальные источники (при недоступности берётся снимок); offline — только сохранённые снимки
DATA_MODE=live
PARSER_INTERVAL_MIN=360
NOTIFY_INTERVAL_MIN=30
TZ=Europe/Moscow