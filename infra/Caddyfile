# SITE_ADDRESS не задан → HTTP на :80 (локально и за туннелем).
# SITE_ADDRESS=домен → Caddy сам получает сертификат Let's Encrypt и включает HTTPS.
# Без покупки домена на VPS подходит sslip.io: IP 1.2.3.4 → 1-2-3-4.sslip.io
{
	admin off
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}